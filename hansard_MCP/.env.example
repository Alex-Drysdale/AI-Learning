# Copy to .env and add your key:  cp .env.example .env
# .env is gitignored by the Pharosyn root .gitignore. This file is committed,
# so it must never contain a real key.

# --- Groq: free, no credit card, fastest. https://console.groq.com ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_replace_me
LLM_MODEL=openai/gpt-oss-120b

# --- Local Ollama: no key needed, value ignored but must be non-empty ---
