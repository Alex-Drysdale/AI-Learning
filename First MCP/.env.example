# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# .env is gitignored. This file (.env.example) is committed, so it must never
# contain a real key - it exists to document which variables are needed.

# --- Groq: free, no credit card, fastest. Key from https://console.groq.com ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_replace_me
LLM_MODEL=openai/gpt-oss-120b

# --- Cerebras: highest free daily volume. https://cloud.cerebras.ai ---
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=csk-replace_me
# LLM_MODEL=llama-3.3-70b

# --- OpenRouter: widest model choice. https://openrouter.ai/keys ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-replace_me
# LLM_MODEL=qwen/qwen3-32b

# --- Local Ollama: no key needed, the value is ignored but must be non-empty ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
